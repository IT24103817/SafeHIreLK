# Optional. Only the "Explain this advert" button uses this.
# The whole app works without it — if this is not set, that button's section
# simply never appears and the rules engine is unaffected.
#
# Set the real value in the Vercel dashboard:
#   Project -> Settings -> Environment Variables -> ANTHROPIC_API_KEY
#
# There is deliberately no VITE_ prefix. A VITE_ variable is compiled into the
# JavaScript that every visitor downloads, which would publish the key.
# This one is read only on the server, in api/explain.js.
#
# Never commit the real key. .env is in .gitignore.
ANTHROPIC_API_KEY=
