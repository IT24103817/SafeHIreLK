# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. The app is complete without any of it:
# the registry search, the advert scanner, the candidate check, the report
# form and the moderation workflow all run with no network at all.
# ---------------------------------------------------------------------------

# 1. AI advert explanation  ("Explain this advert" button)
#
# Read only on the server, in api/explain.js. There is deliberately no VITE_
# prefix — a VITE_ variable is compiled into the JavaScript every visitor
# downloads, which would publish the key.
#
# Set the real value in Vercel:
#   Project -> Settings -> Environment Variables -> ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# 2. Shared reports across devices  (MongoDB Atlas)
#
# Also server-side only, read in api/reports.js. Without it the reports still
# work, they just stay on the device that submitted them.
#   Atlas -> Connect -> Drivers -> copy the connection string
MONGODB_URI=

# 3. Turn the shared-reports feature on in the browser
#
# This one IS a VITE_ variable on purpose: it is a feature switch, not a
# secret. Leave it unset and the app never calls /api/reports at all, which
# keeps the browser console clean on a deployment with no database.
# Set it to "on" only once MONGODB_URI above is configured.
VITE_SHARED_REPORTS=

# Never commit real values. .env is in .gitignore.
